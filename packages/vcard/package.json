{
  "name": "@vcards-io/vcard",
  "version": "0.1.0",
  "description": "Tolerant vCard 2.1/3.0/4.0 (+RFC 9554) reader, 4.0 normaliser and 3.0/4.0 writer",
  "keywords": [
    "vcard",
    "vcf",
    "contacts",
    "parser",
    "rfc6350",
    "rfc2426"
  ],
  "license": "MIT",
  "author": "Rémi Ducceschi",
  "homepage": "https://github.com/remileduc/vcards-io/tree/main/packages/vcard#readme",
  "bugs": "https://github.com/remileduc/vcards-io/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remileduc/vcards-io.git",
    "directory": "packages/vcard"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm run clean && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project vcard"
  },
  "dependencies": {}
}
