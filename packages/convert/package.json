{
  "name": "@vcards-io/convert",
  "version": "0.1.0",
  "description": "vCard <-> JSContact conversion (RFC 9555) with Android, Apple and RFC export profiles",
  "license": "MIT",
  "author": "Rémi Ducceschi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remileduc/vcards-io.git",
    "directory": "packages/convert"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project convert"
  },
  "dependencies": {
    "@vcards-io/jscontact": "workspace:^",
    "@vcards-io/vcard": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
