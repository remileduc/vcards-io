{
  "name": "@vcards-io/convert",
  "version": "0.1.0",
  "description": "vCard <-> JSContact conversion (RFC 9555) with Android, Apple and RFC export profiles",
  "keywords": [
    "vcard",
    "jscontact",
    "contacts",
    "converter",
    "android",
    "apple",
    "rfc9555"
  ],
  "license": "MIT",
  "author": "Rémi Ducceschi",
  "homepage": "https://github.com/remileduc/vcards-io/tree/main/packages/convert#readme",
  "bugs": "https://github.com/remileduc/vcards-io/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remileduc/vcards-io.git",
    "directory": "packages/convert"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm run clean && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project convert"
  },
  "dependencies": {
    "@vcards-io/jscontact": "workspace:^",
    "@vcards-io/vcard": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
