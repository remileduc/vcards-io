{
  "name": "@vcards-io/jscontact",
  "version": "0.1.0",
  "description": "JSContact 2.0 (RFC 9553/9982) types, validator, JSON Pointer/PatchObject utilities and JSON backup",
  "keywords": [
    "jscontact",
    "contacts",
    "validator",
    "json-pointer",
    "rfc9553",
    "rfc9982"
  ],
  "license": "MIT",
  "author": "Rémi Ducceschi",
  "homepage": "https://github.com/remileduc/vcards-io/tree/main/packages/jscontact#readme",
  "bugs": "https://github.com/remileduc/vcards-io/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remileduc/vcards-io.git",
    "directory": "packages/jscontact"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm run clean && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project jscontact"
  },
  "dependencies": {}
}
